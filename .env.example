# Which LLM provider to use. Only "deepseek" is implemented.
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# deepseek-v4-flash / deepseek-v4-pro are the current IDs. The legacy
# deepseek-reasoner / deepseek-chat aliases stop working after 2026-07-24.
# Thinking mode is enabled by the app, not by the ID (see deepseek_provider.py).
# Default to Pro: the Flash/Pro cost gap is negligible, so pay for the better
# model unless a call genuinely benefits from Flash.
DEEPSEEK_MODEL=deepseek-v4-pro
# The Flash seam: a per-call override for pipeline stages that want throughput
# over reasoning depth. The chat loop always uses DEEPSEEK_MODEL above.
DEEPSEEK_MODEL_FAST=deepseek-v4-flash

# Per-request timeout (seconds) for LLM API calls. The SDK default (600s) reads
# as a total UI freeze when a call stalls; capping it makes a stalled request
# fail fast and surface as a visible error instead of hanging.
LLM_TIMEOUT_SECONDS=90

# How hard the card-selection stage may think: low | medium | high | empty.
# Its latency is dominated by output volume, not prompt size — a thinking call
# emits ~9,500 completion tokens against ~490 without, which at ~90 tok/s is the
# entire wait. Measured on one pool: default 93s, medium 74s, low 41s, with low
# returning the same picks. Empty restores the provider default.
SELECT_REASONING_EFFORT=low

# How long a deck must sit unchanged before the LLM power-level nuance is
# recomputed. The panel refreshes after every approval, and each approval used
# to fire a reasoning call on a deck that was about to change again. 0
# recomputes immediately.
POWER_NUANCE_SETTLE_SECONDS=90

# Cap on the chat model's response length (tokens). DeepSeek generates at
# ~40 tok/s, so an unbounded 2000-token answer takes ~50s just to write —
# the dominant cause of slow turns. Bounding output caps worst-case latency
# and keeps replies concise. Pipeline stages set their own limits.
CHAT_MAX_TOKENS=1000

# App log level (DEBUG/INFO/WARNING). INFO surfaces per-stage pipeline timings,
# which is how you diagnose a slow/stuck suggest_cards call.
LOG_LEVEL=INFO

# SQLite db path, relative to backend/
FAMILIAR_DB_PATH=familiar.db

# EDHREC JSON cache directory and TTL (hours)
EDHREC_CACHE_DIR=cache/edhrec
EDHREC_CACHE_TTL_HOURS=24

# Automatic DB backup at app startup.
#   BACKUP_MODE: "folder" (default), "pcloud", or "off".
#   BACKUP_KEEP: how many timestamped snapshots to retain (older are pruned).
#   BACKUP_INTERVAL_HOURS: hours between snapshots after the startup one. A
#     long-running container may not restart for weeks, so the startup
#     snapshot alone is not enough there. 0 keeps only the startup snapshot.
BACKUP_MODE=folder
BACKUP_KEEP=10
BACKUP_INTERVAL_HOURS=24

# folder mode: absolute path to a synced folder (Google Drive / OneDrive /
# Dropbox / pCloud Drive). The app writes snapshots here; that client uploads
# them off-machine. Leave blank to disable folder mode.
BACKUP_DIR=

# pcloud mode only: API token + region host (US -> api.pcloud.com,
# EU -> eapi.pcloud.com). FOLDER_ID 0 = account root.
PCLOUD_AUTH_TOKEN=
PCLOUD_FOLDER_ID=0
PCLOUD_API_HOST=eapi.pcloud.com

# Scryfall oracle-tags bulk cache (~6MB gzipped JSONL, refetched every 24h),
# relative to backend/. Only worth changing to move it onto a mounted volume in
# Docker.
ORACLE_TAGS_CACHE_PATH=oracle_tags_cache.jsonl.gz

# Browser origins allowed to call the API, as a JSON list. Only matters when the
# frontend is served from a different origin than the API (the Vite dev server on
# 5173, or a reverse proxy). Same-origin requests never hit CORS.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Built frontend to serve at "/". Blank uses the repo layout (frontend/dist);
# the Docker image sets this because it flattens the tree.
FRONTEND_DIST_PATH=
